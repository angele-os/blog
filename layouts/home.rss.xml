{{- /*
  Flux RSS de tout le blog (/index.xml).
  Le modèle fourni par Hugo y met TOUTES les pages, « À propos » compris.
  Celui-ci ne garde que les articles du journal et les write-ups.
  Les flux de section (/journal/index.xml…) gardent le modèle de Hugo :
  ils ne contiennent déjà que leurs propres articles.
  Format : RSS 2.0, lu par les lecteurs de flux (Feedly, Thunderbird…).
*/ -}}
{{- $pages := where site.RegularPages "Section" "in" (slice "journal" "writeups") -}}
{{- /* Nombre maximum d'articles : [services.rss] limit dans hugo.toml. */ -}}
{{- with site.Config.Services.RSS.Limit }}{{ if ge . 1 }}{{ $pages = first . $pages }}{{ end }}{{ end -}}
{{- /* Format de date imposé par RSS, ex. « Sun, 18 Oct 2026 00:00:00 +0000 ». */ -}}
{{- $formatDate := "Mon, 02 Jan 2006 15:04:05 -0700" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>fr</language>
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format $formatDate }}</lastBuildDate>
    {{- end }}
    {{- /* Adresse du flux lui-même (recommandé par les validateurs RSS). */}}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format $formatDate }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
